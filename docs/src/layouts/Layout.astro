---
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://cortex.dev').toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />
</head>
<body>
  <slot />

  <!-- Global styles -->
  <style is:global>
    :root {
      --bg: #07090f;
      --bg-soft: #0c0f17;
      --bg-card: #11131c;
      --bg-elev: #161922;
      --border: #232734;
      --border-soft: #1a1e2a;
      --text: #e7e9ee;
      --text-dim: #a4abbb;
      --text-mute: #6b7280;
      --accent: #7c9cff;
      --accent-2: #b07cff;
      --accent-3: #4fe0c0;
      --code-bg: #0b0d14;
      --maxw: 1200px;
      --docw: 860px;
      --radius: 14px;
      --mono: 'JetBrains Mono', 'Fira Code', 'SF Mono', ui-monospace, Menlo, Consolas, monospace;
      --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: #9db5ff; }

    /* ─── shared atoms ─────────────────────────────────────── */
    .glyph {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text; background-clip: text; color: transparent;
      font-weight: 700;
    }

    /* ─── Buttons ───────────────────────────────────────────── */
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 26px; border-radius: 999px;
      font-weight: 600; font-size: 15px; cursor: pointer;
      transition: transform .2s, box-shadow .2s, border-color .2s;
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff; border: none;
      box-shadow: 0 10px 30px -10px rgba(124,156,255,.55);
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 16px 40px -10px rgba(124,156,255,.7); }
    .btn-ghost {
      background: transparent; color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

    /* ─── Landing nav ───────────────────────────────────────── */
    .landing-nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 36px;
      background: rgba(7,9,15,0); backdrop-filter: blur(0);
      transition: background .3s, backdrop-filter .3s, border-color .3s, padding .3s;
      border-bottom: 1px solid transparent;
    }
    .landing-nav.scrolled {
      background: rgba(7,9,15,.82); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-soft);
      padding: 12px 36px;
    }
    .nav-brand {
      display: flex; align-items: center; gap: 9px;
      font-weight: 700; font-size: 18px; color: var(--text);
      letter-spacing: -0.01em;
    }
    .nav-brand .glyph { font-size: 20px; }
    .nav-links { list-style: none; display: flex; gap: 30px; margin: 0; padding: 0; }
    .nav-links a { color: var(--text-dim); font-size: 14px; font-weight: 500; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .nav-cta {
      padding: 8px 18px; border-radius: 999px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff; font-size: 14px; font-weight: 600;
    }
    .nav-cta:hover { color: #fff; opacity: .9; }

    @media (max-width: 760px) {
      .nav-links { display: none; }
      .landing-nav { padding: 14px 20px; }
    }

    /* ─── Hero ──────────────────────────────────────────────── */
    .hero {
      position: relative; min-height: 100vh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 120px 24px 80px; overflow: hidden;
    }
    .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
    .hero-grid {
      position: absolute; inset: -2px;
      background-image:
        linear-gradient(rgba(124,156,255,.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(124,156,255,.05) 1px, transparent 1px);
      background-size: 46px 46px;
      mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 30%, transparent 75%);
    }
    .hero-glow {
      position: absolute; border-radius: 50%; filter: blur(90px); opacity: .42;
    }
    .hero-glow.one {
      width: 520px; height: 520px;
      background: radial-gradient(circle, var(--accent), transparent 70%);
      top: -80px; left: 8%; animation: drift1 18s ease-in-out infinite;
    }
    .hero-glow.two {
      width: 440px; height: 440px;
      background: radial-gradient(circle, var(--accent-2), transparent 70%);
      bottom: -60px; right: 10%; animation: drift2 22s ease-in-out infinite;
    }
    .hero-glow.three {
      width: 320px; height: 320px;
      background: radial-gradient(circle, var(--accent-3), transparent 70%);
      top: 40%; left: 45%; opacity: .22; animation: drift3 26s ease-in-out infinite;
    }
    @keyframes drift1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(40px,30px); } }
    @keyframes drift2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-30px,-20px); } }
    @keyframes drift3 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(20px,-30px); } }

    .hero-content { position: relative; z-index: 1; max-width: 880px; text-align: center; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px; border-radius: 999px;
      background: rgba(124,156,255,.08); border: 1px solid rgba(124,156,255,.2);
      font-size: 13px; color: var(--text-dim); margin-bottom: 28px;
    }
    .hero-badge .dot {
      width: 7px; height: 7px; border-radius: 50%; background: var(--accent-3);
      box-shadow: 0 0 8px var(--accent-3);
    }
    .hero-title {
      font-size: clamp(38px, 6vw, 68px); line-height: 1.05;
      font-weight: 800; letter-spacing: -0.03em; margin: 0 0 24px;
    }
    .hero-title .gradient {
      background: linear-gradient(120deg, var(--accent), var(--accent-2) 60%, var(--accent-3));
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .hero-sub {
      font-size: 18px; line-height: 1.65; color: var(--text-dim);
      max-width: 680px; margin: 0 auto 40px;
    }
    .hero-sub strong { color: var(--text); font-weight: 600; }
    .hero-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

    /* ─── Terminal mockup ────────────────────────────────────── */
    .terminal-mock { margin: 56px auto 0; max-width: 680px; }
    .terminal-window {
      border-radius: 12px; overflow: hidden;
      border: 1px solid var(--border); background: var(--code-bg);
      box-shadow: 0 30px 80px -20px rgba(0,0,0,.6), 0 0 0 1px rgba(124,156,255,.06);
      text-align: left;
    }
    .terminal-bar {
      display: flex; align-items: center; gap: 7px;
      padding: 11px 14px; background: var(--bg-elev); border-bottom: 1px solid var(--border-soft);
    }
    .terminal-dot { width: 11px; height: 11px; border-radius: 50%; }
    .terminal-dot.r { background: #ff5f57; } .terminal-dot.y { background: #febc2e; } .terminal-dot.g { background: #28c840; }
    .terminal-title { margin-left: 12px; font-family: var(--mono); font-size: 12px; color: var(--text-mute); }
    .terminal-body { padding: 16px 18px; font-family: var(--mono); font-size: 12.5px; line-height: 1.7; min-height: 260px; }
    .t-line { white-space: pre; }
    /* Real cortex palette (from internal/ui/theme.go, dark variants) */
    .t-notice { color: #6B7280; }                       /* colorMuted — notices, status facts */
    .t-user { color: #67E8F9; font-weight: 600; }       /* colorUser */
    .t-mark { color: #FDBA74; font-weight: 700; }      /* colorBrand — the ❯ glyph */
    .t-rail { color: #4B5563; }                          /* colorFaint — tool card rails */
    .t-toolname { color: #7DD3FC; font-weight: 700; }   /* colorTool */
    .t-toolargs { color: #6B7280; }                      /* colorMuted */
    .t-ok { color: #86EFAC; }                            /* colorOK */
    .t-assistant { color: #A5B4FC; }                     /* colorAssistant */
    .t-status { margin-top: 2px; }
    .t-st { color: #4B5563; }                             /* styleStatus (faint) */
    .t-st-pruner { color: #D8B4FE; }                     /* colorPruner */
    .t-inputbox {
      margin-top: 6px; border: 1px solid #4B5563; border-radius: 8px; padding: 2px 8px;
      display: inline-block; min-width: 60%;
    }
    .t-inputrow { white-space: pre; line-height: 1.5; }
    .t-cursor {
      display: inline-block; width: 7px; height: 14px; vertical-align: text-bottom;
      background: #FDBA74; margin-left: 3px;
      animation: blink 1s steps(2) infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }

    /* ─── Stats ─────────────────────────────────────────────── */

    /* ─── Stats ─────────────────────────────────────────────── */
    .stats {
      display: flex; justify-content: center; gap: 56px; flex-wrap: wrap;
      padding: 24px 24px 60px; max-width: 880px; margin: 0 auto;
    }
    .stat { text-align: center; }
    .stat-num { font-size: 38px; font-weight: 800; letter-spacing: -0.02em; color: var(--text); }
    .stat-label { font-size: 13px; color: var(--text-mute); margin-top: 4px; }

    /* ─── Sections ──────────────────────────────────────────── */
    .section { max-width: var(--maxw); margin: 0 auto; padding: 60px 24px; }
    .section-head { text-align: center; max-width: 680px; margin: 0 auto 56px; }
    .section-eyebrow {
      font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 14px;
    }
    .section-title { font-size: clamp(28px, 4vw, 40px); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 16px; }
    .section-sub { font-size: 17px; color: var(--text-dim); margin: 0; }

    /* ─── Feature grid ──────────────────────────────────────── */
    .features {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
    }
    @media (max-width: 900px) { .features { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .features { grid-template-columns: 1fr; } }
    .feature {
      padding: 28px 24px; border-radius: var(--radius);
      background: linear-gradient(180deg, var(--bg-card), var(--bg-soft));
      border: 1px solid var(--border-soft);
      transition: border-color .25s, transform .25s;
    }
    .feature:hover { border-color: rgba(124,156,255,.4); transform: translateY(-3px); }
    .feature-icon {
      width: 44px; height: 44px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; margin-bottom: 18px;
      background: rgba(124,156,255,.1); border: 1px solid rgba(124,156,255,.18);
    }
    .feature-title { font-size: 17px; font-weight: 700; margin: 0 0 10px; }
    .feature-desc { font-size: 14.5px; color: var(--text-dim); line-height: 1.6; margin: 0; }
    .feature-desc code { color: var(--accent-3); font-family: var(--mono); font-size: 13px; }

    /* ─── Pipeline ──────────────────────────────────────────── */
    .pipeline {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
    }
    @media (max-width: 900px) { .pipeline { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 500px) { .pipeline { grid-template-columns: 1fr; } }
    .pipe-step {
      position: relative; padding: 28px 22px; border-radius: var(--radius);
      background: var(--bg-card); border: 1px solid var(--border-soft);
    }
    .pipe-num {
      position: absolute; top: 16px; right: 18px;
      font-family: var(--mono); font-size: 13px; color: var(--text-mute); font-weight: 600;
    }
    .pipe-icon { font-size: 30px; margin-bottom: 16px; }
    .pipe-title { font-size: 17px; font-weight: 700; margin: 0 0 8px; }
    .pipe-desc { font-size: 14px; color: var(--text-dim); margin: 0; line-height: 1.55; }

    /* ─── Showcase ──────────────────────────────────────────── */
    .showcase {
      display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
      background: linear-gradient(180deg, var(--bg-card), var(--bg-soft));
      border: 1px solid var(--border-soft); border-radius: 20px; padding: 44px;
    }
    @media (max-width: 900px) { .showcase { grid-template-columns: 1fr; padding: 30px; } }
    .showcase h3 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 16px; }
    .showcase p { color: var(--text-dim); margin: 0 0 20px; }
    .showcase-list { list-style: none; padding: 0; margin: 0; }
    .showcase-list li { display: flex; gap: 10px; margin-bottom: 12px; color: var(--text-dim); font-size: 15px; }
    .showcase-list .check { color: var(--accent-3); flex-shrink: 0; }
    .showcase-list code { color: var(--accent-3); font-family: var(--mono); font-size: 13px; }
    .code-block {
      background: var(--code-bg); border-radius: 12px; padding: 22px;
      border: 1px solid var(--border-soft); overflow-x: auto;
    }
    .code-block pre { margin: 0; font-family: var(--mono); font-size: 13px; line-height: 1.7; }
    .c-com { color: var(--text-mute); }
    .c-key { color: var(--accent); }
    .c-str { color: var(--accent-3); }

    /* ─── CTA band ──────────────────────────────────────────── */
    .cta-band {
      text-align: center; padding: 90px 24px;
      background: radial-gradient(ellipse at center, rgba(124,156,255,.08), transparent 70%);
    }
    .cta-band h2 { font-size: clamp(28px, 4vw, 40px); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 14px; }
    .cta-band p { color: var(--text-dim); margin: 0 0 32px; }

    /* ─── Footer ────────────────────────────────────────────── */
    .footer { border-top: 1px solid var(--border-soft); padding: 32px 36px; }
    .footer-inner { max-width: var(--maxw); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
    .footer-brand { display: flex; align-items: center; font-weight: 600; color: var(--text); }
    .footer-meta { color: var(--text-mute); font-size: 13px; font-weight: 400; }
    .footer-links { display: flex; gap: 24px; }
    .footer-links a { color: var(--text-dim); font-size: 14px; }
    .footer-links a:hover { color: var(--text); }

    /* ══════════════════════════════════════════════════════════
       DOCS LAYOUT
       ══════════════════════════════════════════════════════════ */
    .docs-shell {
      display: grid; grid-template-columns: 260px 1fr;
      max-width: var(--maxw); margin: 0 auto; min-height: 100vh;
    }
    .docs-sidebar {
      position: sticky; top: 0; align-self: start;
      height: 100vh; overflow-y: auto;
      padding: 28px 20px; border-right: 1px solid var(--border-soft);
      background: var(--bg-soft);
    }
    .sb-brand {
      display: flex; align-items: center; gap: 9px;
      font-weight: 700; font-size: 17px; margin-bottom: 28px;
    }
    .sb-brand a { color: var(--text); }
    .sb-brand .glyph { font-size: 19px; }
    .sb-section { margin-bottom: 26px; }
    .sb-section-title {
      font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text-mute); margin-bottom: 10px; padding-left: 10px;
    }
    .sb-section ul { list-style: none; padding: 0; margin: 0; }
    .sb-section li a {
      display: block; padding: 7px 10px; border-radius: 7px;
      color: var(--text-dim); font-size: 14px; transition: background .15s, color .15s;
    }
    .sb-section li a:hover { color: var(--text); background: rgba(255,255,255,.03); }
    .sb-section li a.active { color: var(--accent); background: rgba(124,156,255,.1); font-weight: 600; }

    .docs-content {
      width: 100%; padding: 48px 48px 80px;
    }
    @media (max-width: 900px) {
      .docs-shell { grid-template-columns: 1fr; }
      .docs-sidebar { position: static; height: auto; border-right: none; border-bottom: 1px solid var(--border-soft); }
      .docs-content { padding: 32px 24px 60px; }
    }

    /* ─── Doc typography ─────────────────────────────────────── */
    .docs-content h1 {
      font-size: clamp(30px, 4vw, 40px); font-weight: 800; letter-spacing: -0.025em;
      margin: 0 0 10px; line-height: 1.1;
    }
    .docs-content .lede {
      font-size: 19px; color: var(--text-dim); margin: 0 0 36px; line-height: 1.6;
    }
    .docs-content h2 {
      font-size: 24px; font-weight: 700; letter-spacing: -0.02em;
      margin: 44px 0 16px; padding-top: 8px;
      border-top: 1px solid var(--border-soft);
    }
    .docs-content h3 { font-size: 18px; font-weight: 700; margin: 30px 0 12px; }
    .docs-content p { margin: 0 0 16px; color: var(--text); }
    .docs-content ul, .docs-content ol { margin: 0 0 18px; padding-left: 22px; }
    .docs-content li { margin-bottom: 8px; }
    .docs-content code {
      font-family: var(--mono); font-size: 0.88em;
      background: rgba(124,156,255,.1); color: var(--accent-3);
      padding: 2px 6px; border-radius: 5px;
    }
    .docs-content pre {
      background: var(--code-bg); border: 1px solid var(--border-soft);
      border-radius: 10px; padding: 18px 20px; overflow-x: auto;
      margin: 0 0 20px;
    }
    .docs-content pre code {
      background: none; color: var(--text); padding: 0; font-size: 13.5px; line-height: 1.7;
    }
    .docs-content blockquote {
      margin: 0 0 20px; padding: 14px 18px;
      border-left: 3px solid var(--accent); background: rgba(124,156,255,.06);
      border-radius: 0 8px 8px 0; color: var(--text-dim);
    }
    .docs-content table {
      width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: 14.5px;
    }
    .docs-content th, .docs-content td {
      text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border-soft);
      vertical-align: top;
    }
    .docs-content th { font-weight: 600; color: var(--text-dim); font-size: 13px; }
    .docs-content td code { font-size: 13px; }

    /* ─── Callouts ──────────────────────────────────────────── */
    .callout {
      display: flex; gap: 14px; padding: 16px 18px; border-radius: 10px;
      margin: 0 0 22px; border: 1px solid var(--border-soft);
    }
    .callout .ico { font-size: 18px; flex-shrink: 0; line-height: 1.5; }
    .callout-body { font-size: 14.5px; color: var(--text-dim); }
    .callout-body strong { color: var(--text); }
    .callout.info { background: rgba(124,156,255,.06); border-color: rgba(124,156,255,.2); }
    .callout.tip  { background: rgba(79,224,192,.06); border-color: rgba(79,224,192,.2); }
    .callout.warn { background: rgba(254,188,46,.06); border-color: rgba(254,188,46,.2); }

    /* ─── Taxonomy tree (docs index) ────────────────────────── */
    .taxonomy { margin: 0 0 32px; }
    .taxonomy h2 { border-top: none; padding-top: 0; margin-top: 0; }
    .tree {
      background: var(--code-bg); border: 1px solid var(--border-soft); border-radius: 12px;
      padding: 22px 24px; overflow-x: auto;
      font-family: var(--mono); font-size: 13px; line-height: 1.85; color: var(--text-dim);
      margin: 0;
    }
    .quick-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 16px 0 0;
    }
    @media (max-width: 760px) { .quick-grid { grid-template-columns: 1fr; } }
    .quick-card {
      padding: 20px; border-radius: 12px; background: var(--bg-card);
      border: 1px solid var(--border-soft);
    }
    .quick-title {
      font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 12px;
    }
    .quick-card ul { list-style: none; padding: 0; margin: 0; }
    .quick-card li { margin-bottom: 7px; }
    .quick-card a { font-size: 14px; color: var(--text-dim); }
    .quick-card a:hover { color: var(--text); }

    /* ─── Layer diagram (architecture) ────────────────────── */
    .layer-diagram { margin: 28px 0; }
    .layer { border-radius: 14px; padding: 18px 20px; border: 1px solid var(--border-soft); }
    .layer-cortex { background: linear-gradient(135deg, rgba(124,156,255,.06), rgba(176,124,255,.04)); }
    .layer-axon { background: rgba(79,224,192,.05); border-color: rgba(79,224,192,.18); }
    .layer-tag { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; }
    .layer-axon .layer-tag { color: var(--accent-2); }
    .ext-link { font-size: 11px; font-weight: 600; color: var(--accent-2); margin-left: 8px; text-decoration: none; }
    .ext-link:hover { text-decoration: underline; }
    .layer-rows { display: flex; flex-direction: column; gap: 10px; }
    .layer-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .mod-card { flex: 1; min-width: 140px; padding: 12px 14px; border-radius: 9px; background: rgba(0,0,0,.25); border: 1px solid var(--border-soft); }
    .mod-card.accent { border-color: rgba(124,156,255,.25); }
    .mod-card.axon { border-color: rgba(79,224,192,.22); }
    .mod-name { display: block; font-family: var(--mono); font-size: 13.5px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
    .mod-card.axon .mod-name { color: #5eead4; }
    .mod-desc { font-size: 12px; color: var(--text-mute); }
    .layer-note { font-size: 12.5px; color: var(--text-mute); font-style: italic; margin-top: 2px; }
    .layer-gap { text-align: center; padding: 14px 0; position: relative; }
    .gap-label { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); background: var(--bg); padding: 0 12px; position: relative; z-index: 1; }
    .layer-gap::before { content: ''; position: absolute; left: 20%; right: 20%; top: 50%; height: 1px; background: var(--border-soft); }

    /* ─── Rules grid ───────────────────────────────────────── */
    .rules-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 16px 0 24px; }
    @media (max-width: 680px) { .rules-grid { grid-template-columns: 1fr; } }
    .rule-card { display: flex; gap: 14px; padding: 18px; border-radius: 12px; background: var(--bg-card); border: 1px solid rgba(254,188,46,.22); }
    .rule-num { font-size: 26px; font-weight: 800; color: var(--accent-3); line-height: 1; flex-shrink: 0; }
    .rule-text { font-size: 14.5px; color: var(--text-dim); }
    .rule-text strong { color: var(--text); }

    /* ─── Wire flow ────────────────────────────────────────── */
    .wire-flow { display: flex; align-items: stretch; gap: 6px; margin: 16px 0 24px; flex-wrap: wrap; }
    .wire-step { flex: 1; min-width: 130px; padding: 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border-soft); text-align: center; }
    .wire-ico { font-size: 22px; margin-bottom: 8px; }
    .wire-t { font-size: 13.5px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
    .wire-d { font-size: 11.5px; color: var(--text-mute); line-height: 1.45; }
    .wire-arrow { display: flex; align-items: center; color: var(--accent); font-weight: 700; font-size: 18px; }
    @media (max-width: 680px) { .wire-arrow { transform: rotate(90deg); width: 100%; justify-content: center; } }

    /* ─── Compare cards ─────────────────────────────────────── */
    .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 16px 0 24px; }
    @media (max-width: 680px) { .compare { grid-template-columns: 1fr; } }
    .compare-card { padding: 18px; border-radius: 12px; border: 1px solid var(--border-soft); }
    .compare-card.bad { background: rgba(252,165,165,.05); border-color: rgba(252,165,165,.18); }
    .compare-card.good { background: rgba(134,239,172,.05); border-color: rgba(134,239,172,.2); }
    .compare-tag { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }
    .compare-card.bad .compare-tag { color: #fca5a5; }
    .compare-card.good .compare-tag { color: #86efac; }
    .compare-body { font-size: 14px; color: var(--text-dim); }

    /* ─── Sinks diagram (trace-log) ─────────────────────────── */
    .sinks-diagram { margin: 28px 0; text-align: center; }
    .sink-source { display: inline-flex; flex-direction: column; align-items: center; gap: 4px; }
    .sink-tag { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mute); }
    .sink-box { padding: 10px 24px; border-radius: 10px; background: rgba(79,224,192,.08); border: 1px solid rgba(79,224,192,.25); font-family: var(--mono); font-weight: 700; color: #5eead4; font-size: 14px; }
    .sink-sub { font-size: 12px; color: var(--text-mute); }
    .sink-fan { padding: 8px 0; }
    .sink-arrow { font-size: 20px; color: var(--accent); line-height: 1; }
    .sink-label { font-size: 12px; color: var(--text-mute); margin-top: 2px; }
    .sink-rows { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .sink-card { flex: 1; min-width: 180px; max-width: 240px; padding: 14px; border-radius: 10px; background: var(--bg-card); border: 1px solid var(--border-soft); text-align: left; }
    .sink-card.accent { border-color: rgba(124,156,255,.3); }
    .sink-name { font-family: var(--mono); font-weight: 700; font-size: 13px; color: var(--text); margin-bottom: 5px; }
    .sink-card.accent .sink-name { color: var(--accent); }
    .sink-desc { font-size: 12.5px; color: var(--text-mute); }
    .sink-note { font-size: 13px; color: var(--text-dim); max-width: 560px; margin: 18px auto 0; line-height: 1.6; }

    /* ─── Pager ─────────────────────────────────────────────── */
    .docs-pager { margin-top: 56px; }
    :global(.pager) {
      display: flex; flex-direction: column; gap: 4px;
      padding: 14px 18px; border-radius: 10px;
      border: 1px solid var(--border-soft); background: var(--bg-card);
      transition: border-color .2s, transform .2s;
    }
    :global(.pager:hover) { border-color: rgba(124,156,255,.4); transform: translateY(-1px); }
    :global(.pager.next) { text-align: right; }
    :global(.pager-dir) { font-size: 12px; color: var(--text-mute); }
    :global(.pager-title) { font-size: 15px; font-weight: 600; color: var(--text); }
    .docs-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    @media (max-width: 560px) { .docs-pager { grid-template-columns: 1fr; } }
  </style>
</body>
</html>
