---
// Theme toggle — a single button that flips the data-theme attribute on <html>.
// The no-FOUC inline script in <head> sets the initial attribute before paint;
// this component only handles the click.
---
<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  title="Toggle theme"
>
  <svg class="theme-icon theme-icon-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
  <svg class="theme-icon theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
</button>

<style is:global>
  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 9px;
    background: var(--tint); border: 1px solid var(--border-soft);
    color: var(--text-dim); cursor: pointer; line-height: 0;
    transition: border-color .2s, color .2s, background .2s;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--text); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-icon { display: none; }
  html[data-theme="dark"] .theme-icon-dark { display: block; }
  html[data-theme="light"] .theme-icon-light { display: block; }
  /* default (no attribute yet, before JS runs) = dark */
  html:not([data-theme="light"]) .theme-icon-dark { display: block; }
</style>
