---
import Doc from '../../../layouts/Doc.astro';
import Pager from '../../../components/Pager.astro';
const slug = 'reference/cli';
---
<Doc slug={slug} title="CLI">
  <h1>CLI reference</h1>
  <table>
    <thead><tr><th>Flag</th><th>Default</th><th>Behavior</th></tr></thead>
    <tbody>
      <tr><td><code>--config &lt;path&gt;</code></td><td>unset</td><td>Read one config file; environment overrides still apply</td></tr>
      <tr><td><code>--prompt &lt;text&gt;</code></td><td>unset</td><td>Run one turn with answer on stdout and activity on stderr</td></tr>
      <tr><td><code>--acp</code></td><td>false</td><td>Serve ACP v1 over stdio</td></tr>
      <tr><td><code>--stdio</code></td><td>false</td><td>Serve the editor JSON bridge</td></tr>
      <tr><td><code>--version</code></td><td>false</td><td>Print version, commit and build date</td></tr>
    </tbody>
  </table>
  <p>Source builds report <code>cortex dev (none, built unknown)</code> unless build metadata is set with linker flags.</p>
  <div class="docs-pager"><Pager slug={slug} /></div>
</Doc>
