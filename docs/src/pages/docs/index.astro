---
import Doc from '../../layouts/Doc.astro';
import { nav } from '../../nav';
---
<Doc slug="" title="cortex documentation">
  <h1>cortex documentation</h1>
  <p class="lede">Cortex is a terminal coding agent that uses the Axon runtime.</p>
  {nav.map((section) => (
    <section>
      <h2>{section.label}</h2>
      <ul>
        {section.pages.map((page) => (
          <li><a href={`${page.slug}/`}>{page.title}</a></li>
        ))}
      </ul>
    </section>
  ))}
</Doc>
